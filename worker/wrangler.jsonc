{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "colony",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "../dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "colony",
      "database_id": "8fc6048f-a6ff-450a-a363-d30d4b82e02c",
      "migrations_dir": "../migrations"
    }
  ],
  "vars": {
    "AGENT_URL": "https://colony-agent.sachinkumarskrose.workers.dev"
  },
  "durable_objects": {
    "bindings": [
      { "name": "CLAIM_BOARD", "class_name": "ClaimBoard" },
      { "name": "TASK_COLONY", "class_name": "TaskColony" },
      { "name": "MERGE_QUEUE", "class_name": "MergeQueue" },
      { "name": "TRUST_REGISTRY", "class_name": "TrustRegistry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ClaimBoard"] },
    { "tag": "v2", "new_sqlite_classes": ["TaskColony"] },
    { "tag": "v3", "new_sqlite_classes": ["MergeQueue"] },
    { "tag": "v4", "new_sqlite_classes": ["TrustRegistry"] }
  ],
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "colony-events" }],
    "consumers": [{ "queue": "colony-events", "max_batch_size": 10, "max_batch_timeout": 5 }]
  },
  "ai": { "binding": "AI" },
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "colony-demo" }],
  "services": [{ "binding": "AGENT_WORKER", "service": "colony-agent" }]
}
